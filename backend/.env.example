# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=15

# Database (local SQLite default; use Postgres in cloud)
DATABASE_URL=sqlite+pysqlite:///./docuguard.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/docuguard

# Azure Blob Storage (leave blank for local file storage)
BLOB_ACCOUNT_URL=
BLOB_CONTAINER=documents
BLOB_CONNECTION_STRING=

# Azure Document Intelligence
DOCINTEL_ENDPOINT=
DOCINTEL_KEY=
DOCINTEL_MODEL_ID=prebuilt-document

# Azure AI Foundry (Azure OpenAI compatible)
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=gpt-4o-mini
FOUNDRY_API_VERSION=2024-10-21

# Scoring thresholds
TAMPER_THRESHOLD_REVIEW=0.4
TAMPER_THRESHOLD_REJECT=0.7
