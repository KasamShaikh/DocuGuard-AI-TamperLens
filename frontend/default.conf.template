server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Backend upstream is injected at container start via BACKEND_UPSTREAM.
    # Local docker-compose: http://backend:8000
    # Azure Container Apps: http://docuguard-api (internal ingress on port 80)
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        # Container Apps internal ingress rejects HTTP/1.0 with 426; force 1.1.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 20m;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
